   items=[
     {"question": "Can I add GitHub, Discord, or other OAuth providers?", "answer": "Yes. Better Auth supports many OAuth providers. Add the provider credentials to .env.local and enable it in NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS. See the Better Auth docs for provider-specific setup."},
     {"question": "What's the difference between magic links and OTP?", "answer": "Magic links send a clickable URL that signs you in. OTP sends a numeric code you type. Magic links are more convenient but can be caught by email scanners. OTP is more reliable for enterprise environments."},
     {"question": "How long do sessions last?", "answer": "By default, sessions last 7 days with sliding expiration. You can configure this in the Better Auth options. For security-sensitive apps, consider shorter sessions with more frequent re-authentication."},
     {"question": "Can users sign up with OAuth only (no password)?", "answer": "Yes. If a user signs up with Google, they don't need a password. They can later add a password in settings if they want email/password as a backup. Better Auth handles both flows seamlessly."}
   ]
