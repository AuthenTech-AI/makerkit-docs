   title="Frequently Asked Questions"
   items=[
     {"question": "How do I add a new email type?", "answer": "Create a template in packages/email-templates/src/emails/, export a render function, add the export to index.ts, then call it from your feature code (Server Action, API route, or Better Auth hook)."},
     {"question": "Can I use a different email for production vs staging?", "answer": "Yes. Set EMAIL_SENDER differently per environment in .env.production vs .env.staging. The templates use the from address passed at send time."},
     {"question": "Why are admin emails templates only?", "answer": "Admin moderation workflows vary: some apps auto-ban on reports, others require manual review. We provide templates but leave the triggering logic to your implementation."},
     {"question": "How do I test all email types locally?", "answer": "Trigger each flow manually: sign up (verification), request password reset, invite a team member, etc. Check Mailpit at localhost:8025 for each email."},
     {"question": "Can I disable all emails and use SMS instead?", "answer": "Partially. Better Auth supports SMS OTP as an alternative. However, invitation emails require custom implementation - SMS invites aren't built-in."}
   ]
