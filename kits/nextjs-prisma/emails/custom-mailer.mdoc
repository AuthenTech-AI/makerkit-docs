   items=[
     {"question": "Do I need a custom mailer for SendGrid?", "answer": "No. SendGrid offers SMTP, so use Nodemailer with SendGrid's SMTP credentials. Custom mailers are only needed for providers without SMTP support."},
     {"question": "Can I add custom fields like replyTo or CC?", "answer": "The base MailerSchema supports to, from, subject, text, and html. Extend the schema in mailers-shared and update your implementation for additional fields."},
     {"question": "How do I handle rate limiting?", "answer": "Implement retry logic in your sendEmail method. Use exponential backoff and respect the provider's rate limit headers. Consider a queue for high-volume sending."},
     {"question": "Can I have multiple custom mailers?", "answer": "Yes. Register each with a unique name in the registry. Switch between them by changing MAILER_PROVIDER or by directly calling mailerRegistry.get('mailer-name')."},
