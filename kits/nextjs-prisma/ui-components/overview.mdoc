   title="Frequently Asked Questions"
   items=[
     {"question": "How do I add a shadcn component that's not included?", "answer": "Run pnpm dlx shadcn@latest add <component> from the packages/ui directory. Then fix import paths from @ aliases to # internal imports."},
     {"question": "Can I customize component styles?", "answer": "Yes. Pass className to override styles, or modify the component source in packages/ui/src/shadcn/. Use cn() to merge classes properly."},
     {"question": "Why do some components need 'use client'?", "answer": "Components using React hooks, event handlers, or browser APIs must be Client Components. Server Components can't use useState, useEffect, or onClick."},
     {"question": "How do I use components with React Hook Form?", "answer": "Wrap your form with the Form component, use FormField for each input, and pass field props via the render pattern. See the Forms & Inputs documentation."},
     {"question": "Do components support dark mode?", "answer": "Yes. All components use CSS variables that automatically adapt to the current theme. Use the ModeToggle component to switch themes."}
