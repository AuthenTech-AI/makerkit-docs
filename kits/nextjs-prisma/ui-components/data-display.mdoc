   items=[
     {"question": "When should I use Table vs DataTable?", "answer": "Use Table for simple, static data. Use DataTable when you need sorting, filtering, or pagination - it wraps TanStack Table with built-in controls."},
     {"question": "How do I add sorting to DataTable columns?", "answer": "TanStack Table sorting is configured per column. Add enableSorting: true to the column definition and the header will become clickable."},
     {"question": "Can I use ProfileAvatar without an image?", "answer": "Yes. Pass only displayName and it generates initials automatically. Or pass just text for a single letter/character."},
     {"question": "How do I make skeletons animate?", "answer": "Skeleton has built-in pulse animation. If it's not animating, check that Tailwind's animation utilities aren't being purged."},
     {"question": "What chart types does ChartContainer support?", "answer": "ChartContainer wraps Recharts, supporting all Recharts types: BarChart, LineChart, AreaChart, PieChart, etc. Configure via Recharts components."}
   ]
