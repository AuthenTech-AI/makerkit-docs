   title="Frequently Asked Questions"
   items=[
     {"question": "What is the default rate limit?", "answer": "200 requests per 5 minutes per IP address. This covers all Better Auth API endpoints."},
     {"question": "How is the client identified?", "answer": "By IP address. The kit extracts the real IP from headers like X-Forwarded-For when behind a proxy."},
     {"question": "Where is rate limit data stored?", "answer": "In PostgreSQL by default, using the rateLimit table. This works across multiple server instances. You can switch to Redis/Upstash via BETTER_AUTH_RATE_LIMIT_STORAGE=secondary-storage."},
     {"question": "What happens when a user hits the limit?", "answer": "They receive a 429 Too Many Requests response with a Retry-After header indicating when they can retry."},
     {"question": "Does rate limiting apply to OAuth sign-in?", "answer": "Yes. OAuth endpoints are rate-limited like other auth endpoints. The limit applies to the redirect initiation, not the OAuth provider servers."}
   ]
