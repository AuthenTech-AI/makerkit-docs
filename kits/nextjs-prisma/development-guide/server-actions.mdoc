   items=[
     {"question": "When should I use server actions vs API routes?", "answer": "Use server actions for form submissions and mutations from React components. Use API routes for webhooks, external APIs, or when you need custom headers/status codes."},
     {"question": "How do I handle errors on the client?", "answer": "Check result.serverError and result.validationErrors after calling executeAsync(). Use toast.promise for automatic loading/error states."},
     {"question": "Can I redirect after a server action?", "answer": "Yes. Call redirect() at the end of your action. On the client, let the redirect error propagate - don't catch it."},
     {"question": "How do I access the current user?", "answer": "Use authenticatedActionClient. The middleware injects ctx.user with the authenticated user's data."},
     {"question": "Can I chain multiple middleware?", "answer": "Yes. Call .use() multiple times: authenticatedActionClient.use(middleware1).use(middleware2).action(...). They run in order."}
