{% faq
   title="Frequently Asked Questions"
   items=[
     {"question": "How do I add a new documentation section?", "answer": "Create a new folder in content/documentation/ and add a metadata file with the same name as the folder. Then add page files inside the folder."},
     {"question": "Can I have documentation at multiple URLs?", "answer": "Yes. Create multiple documentation roots by adding routes in app/[locale]/(public)/. Each can point to different content directories."},
     {"question": "How do I add images to documentation?", "answer": "Store images in public/images/docs/ and reference with absolute paths like /images/docs/screenshot.webp. Use descriptive filenames."},
     {"question": "Can I embed videos in documentation?", "answer": "Yes. Use standard Markdoc or create a custom Video component. For YouTube, use an iframe with the embed URL."},
     {"question": "How do I redirect old documentation URLs?", "answer": "Add redirects in next.config.js using the redirects() function. Map old paths to new paths with permanent: true."},
     {"question": "Is documentation content searchable?", "answer": "Yes. The built-in search indexes all published documentation pages. Ensure pages have descriptive titles and descriptions for best results."}
   ]
/%}

