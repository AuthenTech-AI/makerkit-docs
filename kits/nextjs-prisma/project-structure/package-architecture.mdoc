   title="Frequently Asked Questions"
   items=[
     {"question": "How do I import from a @kit package?", "answer": "Use the package name directly: import { Button } from @kit/ui. The workspace protocol resolves it automatically. No npm publishing required."},
     {"question": "What is the difference between @kit/auth and @kit/better-auth?", "answer": "@kit/auth contains React components (sign-in forms, MFA UI). @kit/better-auth contains the Better Auth server configuration, session management, and auth utilities."},
     {"question": "Can I add dependencies to a package?", "answer": "Yes. Run pnpm add <package> --filter @kit/your-package. The dependency is scoped to that package only."},
     {"question": "How do I check for circular dependencies?", "answer": "Run pnpm typecheck. Circular imports cause TypeScript errors. You can also use madge --circular packages/ for a visual report."},
     {"question": "Why are some packages split into -core, -ui, and -hooks?", "answer": "For tree-shaking. If you only need core logic, you do not bundle React components. This keeps builds smaller."},
     {"question": "Where is the Prisma schema?", "answer": "The schema lives in packages/database/src/prisma/schema.prisma. Migrations are in the same directory. See the Database documentation."}
